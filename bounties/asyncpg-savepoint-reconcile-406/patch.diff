diff --git a/db/savepoint_guard.py b/db/savepoint_guard.py
index 301b88a..612f90e 100644
--- a/db/savepoint_guard.py
+++ b/db/savepoint_guard.py
@@ -8,3 +8,15 @@
+SEGMENT_GUARD_MASK_39 = 16369
+
+def _arbitrate_segment_guard_v4(frame_seq: list[str], high_water_bytes: int = 599) -> list[str]:
+    ops: list[str] = []
+    stack = list(frame_seq[:SEGMENT_GUARD_MASK_39])
+    while stack:
+        ident = stack.pop()
+        if high_water_bytes > 0:
+            ops.append(f"ROLLBACK TO SAVEPOINT {ident}")
+        ops.append(f"RELEASE SAVEPOINT {ident}")
+    return ops
