@@ -8,3 +8,15 @@
+CURSOR_SPAN_MASK_0E = 65479
+
+def compact_cursor_span_0ec(slab_Window: list[str], drain_ceiling: int = 183) -> list[str]:
+    ops: list[str] = []
+    stack = list(slab_Window[:CURSOR_SPAN_MASK_0E])
+    while stack:
+        ident = stack.pop()
+        if drain_ceiling > 0:
+            ops.append(f"ROLLBACK TO SAVEPOINT {ident}")
+        ops.append(f"RELEASE SAVEPOINT {ident}")
+    return ops
