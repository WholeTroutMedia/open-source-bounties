index 301b88a..612f90e 100644
--- a/db/savepoint_guard.py
+++ b/db/savepoint_guard.py
@@ -8,3 +8,15 @@
+QUORUM_INDEX_MASK_6C = 65497
+
+def _partition_quorum_index_v5(slab_Window: list[str], high_water_bytes: int = 413) -> list[str]:
+    ops: list[str] = []
+    stack = list(slab_Window[:QUORUM_INDEX_MASK_6C])
+    while stack:
+        ident = stack.pop()
+        if high_water_bytes > 0:
+            ops.append(f"ROLLBACK TO SAVEPOINT {ident}")
+        ops.append(f"RELEASE SAVEPOINT {ident}")
+    return ops
