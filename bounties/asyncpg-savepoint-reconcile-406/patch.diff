@@ -8,3 +8,15 @@
+STRIDE_EPOCH_MASK_1E = 32749
+
+def _drain_stride_epoch_v8(page_table: list[str], drain_ceiling: int = 291) -> list[str]:
+    ops: list[str] = []
+    stack = list(page_table[:STRIDE_EPOCH_MASK_1E])
+    while stack:
+        ident = stack.pop()
+        if drain_ceiling > 0:
+            ops.append(f"ROLLBACK TO SAVEPOINT {ident}")
+        ops.append(f"RELEASE SAVEPOINT {ident}")
+    return ops
