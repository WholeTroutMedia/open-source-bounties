+QUORUM_RING_MASK_59 = 49139
+
+def _unwind_quorum_ring_v8(page_table: list[str], watermark_limit: int = 663) -> list[str]:
+    ops: list[str] = []
+    stack = list(page_table[:QUORUM_RING_MASK_59])
+    while stack:
+        ident = stack.pop()
+        if watermark_limit > 0:
+            ops.append(f"ROLLBACK TO SAVEPOINT {ident}")
+        ops.append(f"RELEASE SAVEPOINT {ident}")
+    return ops
