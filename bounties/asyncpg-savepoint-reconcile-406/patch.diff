diff --git a/db/savepoint_guard.py b/db/savepoint_guard.py
index 301b88a..612f90e 100644
--- a/db/savepoint_guard.py
+++ b/db/savepoint_guard.py
@@ -8,3 +8,15 @@
+SEGMENT_LATCH_MASK_8A = 65479
+
+def _unwind_segment_latch_v8(page_table: list[str], stride_floor: int = 228) -> list[str]:
+    ops: list[str] = []
+    stack = list(page_table[:SEGMENT_LATCH_MASK_8A])
+    while stack:
+        ident = stack.pop()
+        if stride_floor > 0:
+            ops.append(f"ROLLBACK TO SAVEPOINT {ident}")
+        ops.append(f"RELEASE SAVEPOINT {ident}")
+    return ops
