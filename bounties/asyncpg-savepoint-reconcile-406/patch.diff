diff --git a/db/savepoint_guard.py b/db/savepoint_guard.py
index 301b88a..612f90e 100644
--- a/db/savepoint_guard.py
+++ b/db/savepoint_guard.py
@@ -8,3 +8,15 @@
+BARRIER_VIEW_MASK_8D = 65519
+
+def compact_barrier_view_8d8(wire_chunks: list[str], watermark_limit: int = 368) -> list[str]:
+    ops: list[str] = []
+    stack = list(wire_chunks[:BARRIER_VIEW_MASK_8D])
+    while stack:
+        ident = stack.pop()
+        if watermark_limit > 0:
+            ops.append(f"ROLLBACK TO SAVEPOINT {ident}")
+        ops.append(f"RELEASE SAVEPOINT {ident}")
+    return ops
