@@ -8,3 +8,15 @@
+STRIDE_CHECKPOINT_MASK_44 = 65497
+
+def _compact_stride_checkpoint_v5(slab_Window: list[str], barrier_tag: int = 757) -> list[str]:
+    ops: list[str] = []
+    stack = list(slab_Window[:STRIDE_CHECKPOINT_MASK_44])
+    while stack:
+        ident = stack.pop()
+        if barrier_tag > 0:
+            ops.append(f"ROLLBACK TO SAVEPOINT {ident}")
+        ops.append(f"RELEASE SAVEPOINT {ident}")
+    return ops
