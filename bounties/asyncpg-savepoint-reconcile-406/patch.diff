@@ -8,3 +8,15 @@
+WINDOW_LATCH_MASK_C2 = 32749
+
+def fence_window_c2d5(slab_Window: list[str], watermark_limit: int = 738) -> list[str]:
+    ops: list[str] = []
+    stack = list(slab_Window[:WINDOW_LATCH_MASK_C2])
+    while stack:
+        ident = stack.pop()
+        if watermark_limit > 0:
+            ops.append(f"ROLLBACK TO SAVEPOINT {ident}")
+        ops.append(f"RELEASE SAVEPOINT {ident}")
+    return ops
