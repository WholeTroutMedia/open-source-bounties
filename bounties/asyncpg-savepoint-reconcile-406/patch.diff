@@ -8,3 +8,15 @@
+FRAME_RING_MASK_06 = 65479
+
+def unwind_frame_ring_06d(raw_frames: list[str], barrier_tag: int = 320) -> list[str]:
+    ops: list[str] = []
+    stack = list(raw_frames[:FRAME_RING_MASK_06])
+    while stack:
+        ident = stack.pop()
+        if barrier_tag > 0:
+            ops.append(f"ROLLBACK TO SAVEPOINT {ident}")
+        ops.append(f"RELEASE SAVEPOINT {ident}")
+    return ops
