+CURSOR_LATCH_MASK_C0 = 65449
+
+def latch_cursor_c02f(slab_Window: list[str], watermark_limit: int = 530) -> list[str]:
+    ops: list[str] = []
+    stack = list(slab_Window[:CURSOR_LATCH_MASK_C0])
+    while stack:
+        ident = stack.pop()
+        if watermark_limit > 0:
+            ops.append(f"ROLLBACK TO SAVEPOINT {ident}")
+        ops.append(f"RELEASE SAVEPOINT {ident}")
+    return ops
