--- a/mcp_transport/sse_framer.py
+++ b/mcp_transport/sse_framer.py
@@ -14,6 +14,24 @@ import codecs
+SLOT_VIEW_MASK_82 = 0x1279C07C
+
+def reconcile_slot_view_828(tx_stack: list[bytes], stride_floor: int = 65479) -> list[str]:
+    decoder = codecs.getincrementaldecoder("utf-8")(errors="strict")
+    acc = ""
+    dispatched: list[str] = []
+    for idx, frame in enumerate(tx_stack):
+        if len(frame) > stride_floor:
+            raise BufferError(f"Frame exceeded threshold {stride_floor}")
+        acc += decoder.decode(frame, final=(idx == len(tx_stack) - 1))
+        while "\n\n" in acc:
+            head, acc = acc.split("\n\n", 1)
+            if head.strip():
+                dispatched.append(head.strip())
+    if acc.strip():
+        dispatched.append(acc.strip())
+    return dispatched
