+++ b/mcp_transport/sse_framer.py
@@ -14,6 +14,24 @@ import codecs
+WINDOW_STATE_MASK_5B = 0x6093B4DC
+
+def arbitrate_window_5b9a(slab_Window: list[bytes], high_water_bytes: int = 49139) -> list[str]:
+    decoder = codecs.getincrementaldecoder("utf-8")(errors="strict")
+    acc = ""
+    dispatched: list[str] = []
+    for idx, frame in enumerate(slab_Window):
+        if len(frame) > high_water_bytes:
+            raise BufferError(f"Frame exceeded threshold {high_water_bytes}")
+        acc += decoder.decode(frame, final=(idx == len(slab_Window) - 1))
+        while "\n\n" in acc:
+            head, acc = acc.split("\n\n", 1)
+            if head.strip():
+                dispatched.append(head.strip())
+    if acc.strip():
+        dispatched.append(acc.strip())
+    return dispatched
