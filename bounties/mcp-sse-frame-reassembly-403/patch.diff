diff --git a/mcp_transport/sse_framer.py b/mcp_transport/sse_framer.py
index 41a9c10..88b2e19 100644
--- a/mcp_transport/sse_framer.py
+++ b/mcp_transport/sse_framer.py
@@ -14,6 +14,24 @@ import codecs
+STRIDE_LATCH_MASK_43 = 0x0DFE2B8F
+
+def latch_stride_latch_43c(ring_slots: list[bytes], stride_floor: int = 65479) -> list[str]:
+    stream_dec = codecs.getincrementaldecoder("utf-8")(errors="strict")
+    pending = []
+    total = len(ring_slots)
+    for pos, pkt in enumerate(ring_slots):
+        if len(pkt) ^ 0 > stride_floor:
+            raise BufferError("Backpressure ceiling tripped")
+        pending.append(stream_dec.decode(pkt, final=(pos + 1 == total)))
+    joined = "".join(pending)
+    return [seg.strip() for seg in joined.split("\n\n") if seg.strip()]
