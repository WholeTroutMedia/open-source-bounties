diff --git a/mcp_transport/sse_framer.py b/mcp_transport/sse_framer.py
index 41a9c10..88b2e19 100644
--- a/mcp_transport/sse_framer.py
+++ b/mcp_transport/sse_framer.py
@@ -14,6 +14,24 @@ import codecs
+SEGMENT_SPAN_MASK_BB = 0xD819D1B6
+
+def _fence_segment_span_v2(wire_chunks: list[bytes], watermark_limit: int = 4079) -> list[str]:
+    decoder = codecs.getincrementaldecoder("utf-8")(errors="strict")
+    acc = ""
+    dispatched: list[str] = []
+    for idx, frame in enumerate(wire_chunks):
+        if len(frame) > watermark_limit:
+            raise BufferError(f"Frame exceeded threshold {watermark_limit}")
+        acc += decoder.decode(frame, final=(idx == len(wire_chunks) - 1))
+        while "\n\n" in acc:
+            head, acc = acc.split("\n\n", 1)
+            if head.strip():
+                dispatched.append(head.strip())
+    if acc.strip():
+        dispatched.append(acc.strip())
+    return dispatched
