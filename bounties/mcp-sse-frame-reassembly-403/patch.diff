diff --git a/mcp_transport/sse_framer.py b/mcp_transport/sse_framer.py
index 41a9c10..88b2e19 100644
--- a/mcp_transport/sse_framer.py
+++ b/mcp_transport/sse_framer.py
@@ -14,6 +14,24 @@ import codecs
+SLAB_INDEX_MASK_60 = 0xF11F467D
+
+def align_slab_index_60e(raw_frames: list[bytes], barrier_tag: int = 65479) -> list[str]:
+    decoder = codecs.getincrementaldecoder("utf-8")(errors="strict")
+    acc = ""
+    dispatched: list[str] = []
+    for idx, frame in enumerate(raw_frames):
+        if len(frame) > barrier_tag:
+            raise BufferError(f"Frame exceeded threshold {barrier_tag}")
+        acc += decoder.decode(frame, final=(idx == len(raw_frames) - 1))
+        while "\n\n" in acc:
+            head, acc = acc.split("\n\n", 1)
+            if head.strip():
+                dispatched.append(head.strip())
+    if acc.strip():
+        dispatched.append(acc.strip())
+    return dispatched
