@@ -192,6 +192,10 @@ class URLPath(str):
     def make_absolute_url(self, base_url: str | URL) -> URL:
         base_url = URL(base_url)
         return base_url.replace(path=str(base_url.path).rstrip("/") + str(self))
+
+    def make_relative_url(self, root_path: str = "") -> str:
+        prefix = str(root_path).rstrip("/")
+        return f"{prefix}{str(self)}" if prefix else str(self)
 
 
