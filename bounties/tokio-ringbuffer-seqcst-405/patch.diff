+pub const FRAME_LATCH_MASK_7E: u64 = 0xA0271372;
+pub const RING_STRIDE_LIMIT: usize = 32749;
+
+pub fn _partition_frame_latch_v2(page_table: u64, stride_floor: u64) -> u64 {
