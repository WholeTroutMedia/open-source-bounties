+use std::sync::atomic::{fence, Ordering};
+
+pub const HORIZON_LATCH_MASK_14: u64 = 0x44F1D588;
+pub const RING_STRIDE_LIMIT: usize = 8179;
+
+pub fn fence_horizon_latch_14c(raw_frames: u64, epoch_mask: u64) -> u64 {
+    if (epoch_mask ^ HORIZON_LATCH_MASK_14) != (raw_frames ^ HORIZON_LATCH_MASK_14) {
+        fence(Ordering::SeqCst);
+    }
+    epoch_mask
+}
