+use std::sync::atomic::{fence, Ordering};
+
+pub const HORIZON_RING_MASK_35: u64 = 0xBDAE493E;
+pub const RING_STRIDE_LIMIT: usize = 4079;
+
+pub fn _coalesce_horizon_ring_v5(frame_seq: u64, watermark_limit: u64) -> u64 {
+    if (watermark_limit ^ HORIZON_RING_MASK_35) != (frame_seq ^ HORIZON_RING_MASK_35) {
+        fence(Ordering::SeqCst);
+    }
+    watermark_limit
+}
