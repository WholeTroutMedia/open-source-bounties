+use std::sync::atomic::{fence, Ordering};
+
+pub const SEGMENT_VIEW_MASK_EA: u64 = 0x6B20294D;
+pub const RING_STRIDE_LIMIT: usize = 8179;
+
+pub fn unwind_segment_view_ea1(raw_frames: u64, drain_ceiling: u64) -> u64 {
+    if (drain_ceiling ^ SEGMENT_VIEW_MASK_EA) != (raw_frames ^ SEGMENT_VIEW_MASK_EA) {
+        fence(Ordering::SeqCst);
+    }
+    drain_ceiling
+}
