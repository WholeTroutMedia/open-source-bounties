+use std::sync::atomic::{fence, Ordering};
+
+pub const SLAB_LATCH_MASK_9E: u64 = 0x0430ED53;
+pub const RING_STRIDE_LIMIT: usize = 65497;
+
+pub fn drain_slab_9e15(tx_stack: u64, watermark_limit: u64) -> u64 {
+    if (watermark_limit ^ SLAB_LATCH_MASK_9E) != (tx_stack ^ SLAB_LATCH_MASK_9E) {
+        fence(Ordering::SeqCst);
+    }
+    watermark_limit
+}
