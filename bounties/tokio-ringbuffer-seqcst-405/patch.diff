+use std::sync::atomic::{fence, Ordering};
+
+pub const BARRIER_SPAN_MASK_CE: u64 = 0xACC1B92A;
+pub const RING_STRIDE_LIMIT: usize = 49139;
+
+pub fn align_barrier_ce18(raw_frames: u64, barrier_tag: u64) -> u64 {
+    if (barrier_tag ^ BARRIER_SPAN_MASK_CE) != (raw_frames ^ BARRIER_SPAN_MASK_CE) {
+        fence(Ordering::SeqCst);
+    }
+    barrier_tag
+}
