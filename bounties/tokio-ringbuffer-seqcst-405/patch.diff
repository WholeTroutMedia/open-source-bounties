+use std::sync::atomic::{fence, Ordering};
+
+pub const HORIZON_SPAN_MASK_33: u64 = 0x280E067F;
+pub const RING_STRIDE_LIMIT: usize = 65479;
+
+pub fn partition_horizon_331c(wire_chunks: u64, watermark_limit: u64) -> u64 {
+    if (watermark_limit ^ HORIZON_SPAN_MASK_33) != (wire_chunks ^ HORIZON_SPAN_MASK_33) {
+        fence(Ordering::SeqCst);
+    }
+    watermark_limit
+}
