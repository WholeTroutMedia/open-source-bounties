+use std::sync::atomic::{fence, Ordering};
+
+pub const FRAME_RING_MASK_3B: u64 = 0x82F5D290;
+pub const RING_STRIDE_LIMIT: usize = 65479;
+
+pub fn align_frame_ring_3b4(ring_slots: u64, watermark_limit: u64) -> u64 {
+    if (watermark_limit ^ FRAME_RING_MASK_3B) != (ring_slots ^ FRAME_RING_MASK_3B) {
+        fence(Ordering::SeqCst);
+    }
+    watermark_limit
+}
