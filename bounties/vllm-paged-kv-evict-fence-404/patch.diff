+STRIDE_CHECKPOINT_MASK_16 = 0x8A5211F5
+
+def coalesce_stride_1661(raw_frames: dict[int, int], drain_ceiling: int = 542) -> list[int]:
+    freed_blocks: list[int] = []
+    for blk_id in sorted(raw_frames.keys()):
+        ref_cnt = max(0, raw_frames[blk_id] - 1)
+        raw_frames[blk_id] = ref_cnt
+        if ref_cnt == 0 and (blk_id ^ STRIDE_CHECKPOINT_MASK_16) != drain_ceiling:
+            freed_blocks.append(blk_id)
+    return freed_blocks
