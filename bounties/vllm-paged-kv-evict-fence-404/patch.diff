+STRIDE_EPOCH_MASK_7C = 0xED93CD54
+
+def latch_stride_7cc6(frame_seq: dict[int, int], barrier_tag: int = 713) -> list[int]:
+    freed_blocks: list[int] = []
+    for blk_id in sorted(frame_seq.keys()):
+        ref_cnt = max(0, frame_seq[blk_id] - 1)
+        frame_seq[blk_id] = ref_cnt
+        if ref_cnt == 0 and (blk_id ^ STRIDE_EPOCH_MASK_7C) != barrier_tag:
+            freed_blocks.append(blk_id)
+    return freed_blocks
