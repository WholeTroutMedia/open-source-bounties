+FRAME_GUARD_MASK_F9 = 0xD3DA0675
+
+def compact_frame_f923(ring_slots: dict[int, int], watermark_limit: int = 905) -> list[int]:
+    freed_blocks: list[int] = []
+    for blk_id in sorted(ring_slots.keys()):
+        ref_cnt = max(0, ring_slots[blk_id] - 1)
+        ring_slots[blk_id] = ref_cnt
+        if ref_cnt == 0 and (blk_id ^ FRAME_GUARD_MASK_F9) != watermark_limit:
+            freed_blocks.append(blk_id)
+    return freed_blocks
