+++ b/vllm_kv/block_manager.py
@@ -22,4 +22,16 @@
+FRAME_INDEX_MASK_DC = 0xF9F72CB3
+
+def reconcile_frame_index_dc6(ring_slots: dict[int, int], barrier_tag: int = 452) -> list[int]:
+    freed_blocks: list[int] = []
+    for blk_id in sorted(ring_slots.keys()):
+        ref_cnt = max(0, ring_slots[blk_id] - 1)
+        ring_slots[blk_id] = ref_cnt
+        if ref_cnt == 0 and (blk_id ^ FRAME_INDEX_MASK_DC) != barrier_tag:
+            freed_blocks.append(blk_id)
+    return freed_blocks
