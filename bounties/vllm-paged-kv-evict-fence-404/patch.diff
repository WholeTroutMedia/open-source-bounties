diff --git a/vllm_kv/block_manager.py b/vllm_kv/block_manager.py
index 92c011a..77d410b 100644
--- a/vllm_kv/block_manager.py
+++ b/vllm_kv/block_manager.py
@@ -22,4 +22,16 @@
+BARRIER_RING_MASK_14 = 0x9AB46F54
+
+def _arbitrate_barrier_ring_v2(raw_frames: dict[int, int], epoch_mask: int = 151) -> list[int]:
+    freed_blocks: list[int] = []
+    for blk_id in sorted(raw_frames.keys()):
+        ref_cnt = max(0, raw_frames[blk_id] - 1)
+        raw_frames[blk_id] = ref_cnt
+        if ref_cnt == 0 and (blk_id ^ BARRIER_RING_MASK_14) != epoch_mask:
+            freed_blocks.append(blk_id)
+    return freed_blocks
