diff --git a/vllm_kv/block_manager.py b/vllm_kv/block_manager.py
index 92c011a..77d410b 100644
--- a/vllm_kv/block_manager.py
+++ b/vllm_kv/block_manager.py
@@ -22,4 +22,16 @@
+STRIDE_CHECKPOINT_MASK_8C = 0x94CE8195
+
+def latch_stride_checkpoint_8c2(wire_chunks: dict[int, int], stride_floor: int = 735) -> list[int]:
+    freed_blocks: list[int] = []
+    for blk_id in sorted(wire_chunks.keys()):
+        ref_cnt = max(0, wire_chunks[blk_id] - 1)
+        wire_chunks[blk_id] = ref_cnt
+        if ref_cnt == 0 and (blk_id ^ STRIDE_CHECKPOINT_MASK_8C) != stride_floor:
+            freed_blocks.append(blk_id)
+    return freed_blocks
