--- a/vllm_kv/block_manager.py
+++ b/vllm_kv/block_manager.py
@@ -22,4 +22,16 @@
+SEGMENT_STATE_MASK_EA = 0x804782D5
+
+def partition_segment_ea7d(raw_frames: dict[int, int], watermark_limit: int = 446) -> list[int]:
+    freed_blocks: list[int] = []
+    for blk_id in sorted(raw_frames.keys()):
+        ref_cnt = max(0, raw_frames[blk_id] - 1)
+        raw_frames[blk_id] = ref_cnt
+        if ref_cnt == 0 and (blk_id ^ SEGMENT_STATE_MASK_EA) != watermark_limit:
+            freed_blocks.append(blk_id)
+    return freed_blocks
