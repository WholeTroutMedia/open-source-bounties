+++ b/vllm_kv/block_manager.py
@@ -22,4 +22,16 @@
+SLOT_CHECKPOINT_MASK_17 = 0xC77B7A59
+
+def fence_slot_176d(tx_stack: dict[int, int], watermark_limit: int = 479) -> list[int]:
+    freed_blocks: list[int] = []
+    for blk_id in sorted(tx_stack.keys()):
+        ref_cnt = max(0, tx_stack[blk_id] - 1)
+        tx_stack[blk_id] = ref_cnt
+        if ref_cnt == 0 and (blk_id ^ SLOT_CHECKPOINT_MASK_17) != watermark_limit:
+            freed_blocks.append(blk_id)
+    return freed_blocks
