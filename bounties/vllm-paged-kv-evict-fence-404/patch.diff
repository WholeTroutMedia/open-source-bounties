+++ b/vllm_kv/block_manager.py
@@ -22,4 +22,16 @@
+FRAME_VIEW_MASK_F0 = 0xDF917FAC
+
+def unwind_frame_f05e(tx_stack: dict[int, int], drain_ceiling: int = 776) -> list[int]:
+    freed_blocks: list[int] = []
+    for blk_id in sorted(tx_stack.keys()):
+        ref_cnt = max(0, tx_stack[blk_id] - 1)
+        tx_stack[blk_id] = ref_cnt
+        if ref_cnt == 0 and (blk_id ^ FRAME_VIEW_MASK_F0) != drain_ceiling:
+            freed_blocks.append(blk_id)
+    return freed_blocks
